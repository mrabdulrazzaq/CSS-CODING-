.my-alt-button {

    background: linear-gradient(
        135deg,
        #2e2e2eb7 0%,
        #3b3b3b 45%,
        #32b258 100%
    );

    color: #ffffff;

    border: 1px solid rgba(29, 101, 51, 0.154)9);

    padding: 8px 14px;

    display: inline-flex;
    align-items: center;
    gap: 8px;

    border-radius: 8px;

    cursor: pointer;

    font-size: 14px;
    font-weight: 600;

    transition: all 0.3s ease;

    box-shadow:
        0 5px 14px rgba(0,0,0,0.25),
        0 0 10px rgba(29, 101, 50, 0.25);

    position: relative;
    overflow: hidden;
}

/* ICON */
.my-alt-button::before {
    content: "➕";
    font-size: 14px;
}

/* HOVER */
.my-alt-button:hover {
    transform: translateY(-2px);

    border-color: #38ef7e1f;

    box-shadow:
        0 10px 22px rgba(0,0,0,0.35),
        0 0 18px rgba(56, 239, 126, 0.154);
}

/* ACTIVE */
.my-alt-button:active {
    transform: translateY(0px);
}

/* LIGHT SWEEP EFFECT */
.my-alt-button::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: rgba(56, 239, 125, 0.15);
    transform: skewX(-25deg);
    transition: 0.5s;
}

.my-alt-button:hover::after {
    left: 120%;
}

.large-input input,
.large-input textarea,
.large-input select {
    min-height: 20px !important;
}

/* Button Styling */
.large-input button {
    height: 50px;
    background: linear-gradient(135deg, #3ba14f, #3ba14f);
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    border: none;
    border-radius: 10px;
    padding: 4px 8px;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    animation: pulse 2s infinite;
}

/* Hover Effect */
.large-input button:hover {
    background: linear-gradient(135deg, #2e8b47, #2e8b47);
    box-shadow: 0 6px 14px rgba(0, 73, 153, 0.3);
    transform: translateY(-4px);
    animation: bounce 0.5s ease-in-out;
}

/* Bounce Animation */
@keyframes bounce {
    0% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
    100% { transform: translateY(0); }
}

/* Subtle Pulsing Effect */
@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
}
/*--------------------deleterecord--------------------------*/
.deleterecord {
    padding: 10px 12px;
    border-radius: 12px;
    transition: all 0.3s ease;
    transform: scale(1);
    background: rgba(255, 77, 79, 0.08);
}

.deleterecord .fa-trash {
    font-size: 22px;
    color: #ff4d4f;
    transition: all 0.3s ease;
}
.deleterecord:hover {
    background: linear-gradient(135deg, #ff4d4f, #ff7875);
    transform: scale(1.15);
    box-shadow: 0 8px 20px rgba(255, 77, 79, 0.4);
}
.deleterecord:hover .fa-trash {
    color: #fff;
    animation: bounce 0.4s ease;
}
.deleterecord:active {
    transform: scale(0.92);
}
@keyframes bounce {
    0%   { transform: translateY(0); }
    30%  { transform: translateY(-6px); }
    60%  { transform: translateY(3px); }
    100% { transform: translateY(0); }
}
